# Settings of the host processes (api, worker, decoders) of the MVP stack; scripts/dev/mvp-secrets.sh copies this
# file to secrets-dev/mvp.env, which scripts/dev/mvp-up.sh sources. Key names are those of
# src/shared/config/src/table.rs (SUNNYCLOUD_ + key upper-cased). Shell syntax: ${MVP_SECRETS} and ${MVP_DATA} are
# set by the scripts. No secret value lives here: secrets are files named by the *_FILE variables.
#
# Not set on purpose: no test-clock build, no shortened TTLs. Everything below the "TTLs" heading is a release value.

# Public name and listeners. Caddy (host network) is the only process that listens on a public address.
PUBLIC_HOST=drive.zxsanny.com
SUNNYCLOUD_ENVIRONMENT=production
SUNNYCLOUD_PUBLIC_URL=https://drive.zxsanny.com
SUNNYCLOUD_PUBLIC_ADDR=127.0.0.1:8080
SUNNYCLOUD_INTERNAL_ADDR=127.0.0.1:8081
SUNNYCLOUD_OPS_ADDR=127.0.0.1:9090
# Caddy connects from loopback and replaces X-Forwarded-For; only that address may set the client address.
SUNNYCLOUD_TRUSTED_PROXIES=127.0.0.1/32
SUNNYCLOUD_LOG=json

# Certificate authority. Unset = Let's Encrypt STAGING (an untrusted test certificate). For the real certificate
# uncomment the next line and run scripts/dev/mvp-up.sh again (see _docs/04_deploy/mvp_runbook.md).
# ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# Binds who may become admin or redeem an invite to these verified Google addresses (comma separated). Strongly
# advised before the first setup: a leaked setup token then cannot be redeemed by anyone else.
# SUNNYCLOUD_ALLOWLIST_EMAILS=owner@example.com

# Sign-in: Google through the generic OIDC provider. The client id is read from secrets-dev/oidc_client_id by
# mvp-up.sh, the client secret from secrets-dev/provider_oidc_client_secret.
SUNNYCLOUD_OIDC_ISSUER=https://accounts.google.com

# Storage. The free-space floor is the smaller of blob_free_reserve and blob_free_reserve_percent of the volume.
SUNNYCLOUD_BLOB_ROOT=${MVP_DATA}/blobs
SUNNYCLOUD_BLOB_FREE_RESERVE=20GiB
SUNNYCLOUD_DEFAULT_QUOTA=100GiB

# TTLs. retention, tombstone_horizon, orphan_sweep_age and the others keep their release defaults.
SUNNYCLOUD_RETENTION=7d
SUNNYCLOUD_UPLOAD_SESSION_TTL=24h
SUNNYCLOUD_ACCESS_TOKEN_TTL=12h

# Secrets (files). master_key_file names a file that holds the PATH of the 32-byte key.
SUNNYCLOUD_DB_API_URL_FILE=${MVP_SECRETS}/db_api_url
SUNNYCLOUD_DB_MIGRATOR_URL_FILE=${MVP_SECRETS}/db_migrator_url
SUNNYCLOUD_MASTER_KEY_FILE_FILE=${MVP_SECRETS}/master_key_file
SUNNYCLOUD_WORKER_API_TOKEN_FILE=${MVP_SECRETS}/worker_api_token
SUNNYCLOUD_SHARE_GRANT_KEY_FILE=${MVP_SECRETS}/share_grant_key
SUNNYCLOUD_PROVIDER_OIDC_CLIENT_SECRET_FILE=${MVP_SECRETS}/provider_oidc_client_secret

# Worker: talks to the internal listener on loopback; its own ops endpoint on 9092 (the API owns 9090).
SUNNYCLOUD_WORKER_API_URL=http://127.0.0.1:8081
SUNNYCLOUD_WORKER_OPS_LISTEN=127.0.0.1:9092
SUNNYCLOUD_WORKER_SOCK_INTERACTIVE=${MVP_RUN}/decoder-interactive.sock
SUNNYCLOUD_WORKER_SOCK_GENERAL=${MVP_RUN}/decoder-general.sock
SUNNYCLOUD_WORKER_SCRATCH_INTERACTIVE=${MVP_DATA}/scratch-interactive
SUNNYCLOUD_WORKER_SCRATCH_GENERAL=${MVP_DATA}/scratch-general

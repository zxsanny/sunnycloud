# Pinned sources of the decoder media stages (decoder.Dockerfile, AZ-3863; containerization.md, Decoder).
# The fetch stage downloads each URL and fails the build when the SHA-256 differs; a bump is one PR that edits
# the version, the URL and the hash together. check-decoder-image.sh reads the versions from here.
#
# libheif: the project publishes no signature or checksum file; the hash is the one GitHub shows for the release
#   asset (sha256 of libheif-1.23.7.tar.gz), recomputed after download. 1.23.7 is the newest release; the image
#   needs >= 1.22.0 (compiled security limits, the HEVC decode of iPhone photos).
# libvips: the hash equals the release asset vips-8.18.7.tar.xz.sha256sum published next to the tarball.
# ffmpeg: 9.1 (released 2026-11-20) is the newest stable release; the 9.0 branch ends at 9.0.2 and 8.1 at 8.1.3.
#   The tarball signature (ffmpeg-9.1.tar.xz.asc) verifies against the FFmpeg release signing key
#   FCF986EA15E6E293A5644F10B4322F04D67658D8 (ffmpeg.org/ffmpeg-devel.asc). 9.1 has had no point release yet.

LIBHEIF_VERSION=1.23.7
LIBHEIF_URL=https://github.com/strukturag/libheif/releases/download/v1.23.7/libheif-1.23.7.tar.gz
LIBHEIF_SHA256=f7483e818503ea6224c8863e4a56ac02c7089021a98472c811c12aa19faf2475

VIPS_VERSION=8.18.7
VIPS_URL=https://github.com/libvips/libvips/releases/download/v8.18.7/vips-8.18.7.tar.xz
VIPS_SHA256=5baaead3b0bb20ffdb9e9ff09aa9fda08620923df77b63b436654cb5e0b3bf94

FFMPEG_VERSION=9.1
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-9.1.tar.xz
FFMPEG_SHA256=1a4d394ae63d190a526cd052eb4415c156b5c5e2df37efab41a7de0b8fde2433

# ffmpeg demuxers compiled in: the format whitelist of 10_decoder description section 13.1 (gate S5, spike AZ-3849
# on ffmpeg 8.0.1 over SYNTHETIC clips: PROVISIONAL until the reference-host run over the real phone corpus).
# The four names are demuxer source names; mov also reads mp4/m4a/3gp, matroska also reads webm.
FFMPEG_DEMUXERS=mov,matroska,avi,mpegts

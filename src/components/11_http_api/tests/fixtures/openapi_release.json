          "id": {"type": "string", "format": "uuid"},
          "name": {"type": "string"},
          "kind": {"type": "string", "enum": ["file", "folder", "symlink"]},
          "size": {"type": "integer"},
          "parent": {"$ref": "#/components/schemas/NodeView"},
          "labels": {"type": "array", "items": {"type": "object", "properties": {"text": {"type": "string"}}}}
        }
      },
      "ChangePage": {
        "type": "object",
        "required": ["cursor", "entries"],
        "properties": {
          "cursor": {"type": "string"},
          "entries": {"type": "array", "items": {"$ref": "#/components/schemas/NodeView"}}
        }
      }

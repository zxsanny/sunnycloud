      "NodeCreate": {
        "type": "object",
        "required": ["name", "parent_id"],
        "properties": {
          "name": {"type": "string"},
          "parent_id": {"type": "string", "format": "uuid"},
          "kind": {"type": "string", "enum": ["file", "folder"]}
        }
      },
      "NodeView": {
        "type": "object",
        "required": ["id", "name", "kind"],

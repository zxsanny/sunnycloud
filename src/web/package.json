{
  "name": "sunnycloud-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "sunnycloud web app: Svelte 5 single-page application served as static files",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run --reporter verbose",
    "gen:api": "bun scripts/gen-api.mjs",
    "build:wasm": "bash scripts/build-wasm.sh",
    "check:large": "vitest run --config vitest.manual.config.ts --reporter verbose"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@lucide/svelte": "1.73.0",
    "@tailwindcss/vite": "4.3.5",
    "openapi-fetch": "0.17.0",
    "svelte": "5.57.3",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "22.20.4",
    "eslint": "10.15.0",
    "eslint-plugin-svelte": "3.24.0",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "packageManager": "bun@1.4.5"
}
